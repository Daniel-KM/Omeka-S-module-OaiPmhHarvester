{
    "name": "daniel-km/omeka-s-module-oai-pmh-harvester",
    "description": "OAI-PMH Harvester is a module for Omeka S that allows to import records from OAI-PMH data providers.",
    "type": "omeka-module",
    "license": "GNU/GPL v3",
    "authors": [
        {
            "name": "Roy Rosenzweig Center for History and New Media",
            "homepage": "https://rrchnm.org/"
        },
        {
            "name": "Vincent Buard - Numerizen",
            "homepage": "https://numerizen.com/"
        },
        {
            "name": "Daniel Berthereau",
            "homepage": "https://gitlab.com/Daniel-KM"
        },
        {
            "name": "Clément SIPIETER - 6πTech",
            "email": "clement@6pi.tech",
            "homepage": "https://6pi.tech"
        }
    ],
    "scripts": {
        "cs:check": "php-cs-fixer fix --dry-run --diff",
        "cs:fix": "php-cs-fixer fix",
        "stan:check": "phpstan analyse"
    },
    "autoload": {
        "classmap": [
            "src/"
        ]
    },
    "require": {
        "php": ">=8.2"
    },
    "require-dev": {
        "omeka/omeka-s": "^4.1",
        "friendsofphp/php-cs-fixer": "^3.75",
        "phpstan/phpstan": "^2.1"
    },
    "replace": {
        "omeka-s-themes/default": "*"
    },
    "config": {
        "allow-plugins": {
            "omeka/composer-addon-installer": true
        }
    }
}
