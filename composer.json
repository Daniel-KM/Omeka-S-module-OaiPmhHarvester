{
    "name": "daniel-km/omeka-s-module-oai-pmh-harvester",
    "type": "omeka-s-module",
    "description": "Module for Omeka S: Fetch records from remote OAI-PMH repositories.",
    "keywords": [
        "Omeka S",
        "Omeka S module",
        "admin",
        "import"
    ],
    "license": "GPL-3.0-or-later",
    "homepage": "https://gitlab.com/Daniel-KM/Omeka-S-module-OaiPmhHarvester",
    "authors": [
        {
            "name": "Daniel Berthereau",
            "email": "Daniel.packagist@Berthereau.net",
            "role": "Maintainer"
        },
        {
            "name": "Clément SIPIETER - 6πTech",
            "email": "clement@6pi.tech",
            "homepage": "https://6pi.tech"
        },
        {
            "name": "Vincent Buard",
            "homepage": "https://omeka.numerizen.com",
            "role": "Developer"
        },
        {
            "name": "Roy Rosenzweig Center for History and New Media",
            "homepage": "https://rrchnm.org",
            "role": "Original Author"
        }
    ],
    "support": {
        "issues": "https://gitlab.com/Daniel-KM/Omeka-S-module-OaiPmhHarvester/-/issues",
        "forum": "https://forum.omeka.org/"
    },
    "require": {
        "php": "^7.4 || ^8.0"
    },
    "_require (not set until Omeka S merges PR #2432)": {
        "omeka/omeka-s": "^3.0 || ^4.0"
    },
    "require-dev": {
        "phpstan/phpstan": "^2.1"
    },
    "autoload": {
        "psr-4": {
            "OaiPmhHarvester\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OaiPmhHarvesterTest\\": "tests/OaiPmhHarvesterTest/"
        }
    },
    "scripts": {
        "stan:check": "phpstan analyse"
    },
    "extra": {
        "installer-name": "OaiPmhHarvester"
    }
}
